ROZETKA_LANGUAGE=ua
ROZETKA_COUNTRY=UA
ROZETKA_FRONT_TYPE=xl
ROZETKA_HTTP_TIMEOUT_MS=15000
ROZETKA_HTTP_RETRIES=2
ROZETKA_USER_AGENT=rozetka-mcp/0.1 (+https://github.com/sdziupin/rozetka-mcp)

# Advanced / debugging overrides
ROZETKA_SEARCH_API_BASE=https://search.rozetka.com.ua/ua/search/api/v6
ROZETKA_CATALOG_API_BASE=https://xl-catalog-api.rozetka.com.ua/v4
ROZETKA_COMMON_API_BASE=https://common-api.rozetka.com.ua
ROZETKA_PRODUCT_API_BASE=https://product-api.rozetka.com.ua/v4

ROZETKA_DATA_DIR=
ROZETKA_SAVED_SEARCHES_FILE=
